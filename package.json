{
  "name": "another-day-at-work",
  "description": "A workstation survival game built with Phaser.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "build": "vite build --config vite/config.prod.mjs",
    "implement:chunks": "bash scripts/implement-chunks.sh",
    "preview": "vite preview --config vite/config.prod.mjs --logLevel info",
    "test": "tsx --test test/**/*.test.ts"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  },
  "dependencies": {
    "phaser": "4.0.0",
    "terser": "^5.39.0"
  }
}
